{
  "schemaVersion": 1,
  "id": "notenoughhints",
  "version": "${version}",
  "name": "Not Enough Hints",
  "description": "Context-aware, low-profile HUD hints for complex Minecraft modpacks.",
  "authors": [
    "dev2pew"
  ],
  "contact": {
    "sources": "https://github.com/dev2pew/NotEnoughHints",
    "issues": "https://github.com/dev2pew/NotEnoughHints/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.dev2pew.notenoughhints.client.NotEnoughHintsClient"
    ],
    "modmenu": [
      "io.github.dev2pew.notenoughhints.client.config.NehModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft_dependency}",
    "java": ">=21",
    "fabric-api": "${fabric_api_dependency}",
    "yet_another_config_lib_v3": ">=3.8.1"
  },
  "suggests": {
    "modmenu": ">=15.0.2"
  }
}
